[Unit]
Description=Toyota CRM (gunicorn)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
User=crm
Group=crm
WorkingDirectory=/srv/tayota_crm
EnvironmentFile=/etc/tayota-crm.env
ExecStart=/srv/tayota_crm/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 --access-logfile - --error-logfile - tayota_crm.wsgi:application
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/tayota-crm

[Install]
WantedBy=multi-user.target
