# Platform and application wiring shared by every environment.
# Security/host settings that differ per environment shape (HTTPS vs plain
# HTTP, default domain vs custom domain) are set as environment properties
# with `eb setenv`, which takes precedence over this file.
option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: tayota_crm.wsgi:application
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health/
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: tayota_crm.settings
    DJANGO_DEBUG: "False"
    DJANGO_ALLOWED_HOSTS: ".elasticbeanstalk.com"
    DJANGO_CSRF_TRUSTED_ORIGINS: "https://*.elasticbeanstalk.com,http://*.elasticbeanstalk.com"

container_commands:
  01_collectstatic:
    command: "python manage.py collectstatic --noinput"
  02_migrate:
    command: "python manage.py migrate --noinput"
    leader_only: true
