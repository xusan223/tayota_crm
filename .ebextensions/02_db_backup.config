# Daily export of the CRM data to S3.
#
# Free plan accounts may keep RDS automated backups for only one day, so the
# application data is also exported every night with `manage.py dumpdata` and
# stored in the bucket named by the BACKUP_BUCKET environment property. The
# bucket's lifecycle rule removes exports after 14 days. dumpdata is used
# instead of pg_dump because it does not depend on the database server version.
#
# Restore on the instance:
#   aws s3 cp s3://$BACKUP_BUCKET/db/<file>.json.gz - | gunzip > restore.json
#   python manage.py loaddata restore.json

files:
  "/usr/local/bin/tayota-db-backup":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      set -euo pipefail

      # Load the Elastic Beanstalk environment properties (DATABASE_URL, ...).
      eval "$(/opt/elasticbeanstalk/bin/get-config environment | python3 -c '
      import json, shlex, sys
      for key, value in json.load(sys.stdin).items():
          print(f"export {key}={shlex.quote(value)}")
      ')"

      : "${BACKUP_BUCKET:?BACKUP_BUCKET environment property is not set}"

      cd /var/app/current
      PYTHON=$(ls -d /var/app/venv/*/bin/python | head -n 1)
      STAMP=$(date -u +%Y-%m-%dT%H%M%SZ)
      OUT=$(mktemp /tmp/tayota-backup-XXXXXX.json.gz)
      trap 'rm -f "$OUT"' EXIT

      "$PYTHON" manage.py dumpdata --natural-foreign --natural-primary \
          --exclude contenttypes --exclude auth.permission \
          --exclude sessions --exclude admin.logentry | gzip > "$OUT"

      KEY="db/tayota-crm-${STAMP}.json.gz"
      aws s3 cp "$OUT" "s3://${BACKUP_BUCKET}/${KEY}" --only-show-errors
      echo "Backup uploaded to s3://${BACKUP_BUCKET}/${KEY}"

  "/etc/systemd/system/tayota-db-backup.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Toyota CRM database export to S3
      Wants=network-online.target
      After=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/tayota-db-backup

  "/etc/systemd/system/tayota-db-backup.timer":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Daily Toyota CRM database export (02:00 Asia/Tashkent)

      [Timer]
      OnCalendar=*-*-* 21:00:00 UTC
      RandomizedDelaySec=10min
      Persistent=true

      [Install]
      WantedBy=timers.target

commands:
  01_enable_backup_timer:
    command: "systemctl daemon-reload && systemctl enable --now tayota-db-backup.timer"
